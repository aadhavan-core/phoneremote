<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight base theme is intentionally still overridden to force dark:
         RemoteMouseApp.onCreate() calls AppCompatDelegate.setDefaultNightMode(MODE_NIGHT_YES)
         so the whole app (Compose content, status bar, dialogs) always renders dark
         regardless of the system setting. -->
    <style name="Theme.RemoteMouseController" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar" tools:targetApi="27">false</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
